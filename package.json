{
  "name": "@jsagir/mos-stock-flow-mcp",
  "version": "0.3.0",
  "private": false,
  "description": "Free `/m:os` stock-and-flow modeling over MCP and CLI",
  "license": "GPL-3.0-only",
  "type": "module",
  "bin": {
    "mos-flow": "dist/cli.js",
    "mos-mcp": "dist/mcp.js"
  },
  "files": [
    "dist/cli.js",
    "dist/mcp.js",
    "dist/cli/**",
    "dist/core/**",
    "dist/server/**",
    "dist/app/systemicworks/**",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsagir/mos-stock-flow-mcp.git"
  },
  "homepage": "https://github.com/jsagir/mos-stock-flow-mcp#readme",
  "bugs": {
    "url": "https://github.com/jsagir/mos-stock-flow-mcp/issues"
  },
  "keywords": [
    "mcp",
    "systems-thinking",
    "stock-and-flow",
    "causal-loop",
    "wicked-problems"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc && node scripts/copy-app.mjs && node scripts/build-systemicworks.mjs",
    "start": "node dist/server/http.js",
    "mcp:stdio": "node dist/server/stdio.js",
    "smoke:cli": "node scripts/smoke-cli.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "test:app": "vitest run test/app.test.ts",
    "check:docs": "node scripts/check-docs.mjs",
    "smoke:deploy": "node scripts/smoke-deploy.mjs",
    "smoke:all": "npm run smoke:cli && npm run smoke:mcp && npm run smoke:deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.25.12",
    "rxdb": "^17.5.0",
    "rxjs": "^7.8.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "author": "/m:os contributors"
}
